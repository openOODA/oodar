# oodar version and compat contract
#
# Format: oodar=MAJOR.MINOR.PATCH (semver; see RULES.oot §1.21)
# Bump MAJOR: incompatible ABI change (consumers must rebuild).
# Bump MINOR: additive feature (consumers continue to link unchanged).
# Bump PATCH: bug fix.
#
# oodar is the Gen 1 host substrate for compiled openOODA binaries. The
# runtime ABI is the set of oo_* symbols exported by the per-subdir
# .c files. The api_surface field is a structural check: the loader
# asserts the oodar repo ships exactly the declared count of public
# .c files (counted recursively across all 6 per-domain subdirs).

oodar=4.0.65
ooda=2.10.0
ooda_max=2.99.0
api_surface=117
