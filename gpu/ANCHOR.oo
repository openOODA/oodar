//   1. Read gpu.h — the OoGpuDevice, OoGpuBuffer types.
//   2. Read gpu.c — device probe, buffer alloc/free, stream/event.
//   3. Read gpu_hip.c — liboo_hip.so dynamic loader.
//   4. Read hip_kern.hip — the kernel suite (vec_add, sgemm, etc.).
//
